# ═══════════════════════════════════════════════════════════════
#  PN AD NETWORK — Environment
# ═══════════════════════════════════════════════════════════════

# API server (web)
API_PORT=3001
API_HOST=0.0.0.0
FIRST_ADMIN_EMAIL=mdjobayerislam2580@gmail.com
FIRST_ADMIN_PASSWORD=Jobayer01619789895
FIRST_ADMIN_NAME=Jobayer Islam

# Worker — Telegram is disabled; these are DUMMY values just to pass startup validation
TELEGRAM_BOT_TOKEN=worker_mode_disabled_no_telegram
ADMIN_IDS=1

# Firebase (single file for BOTH web + worker)
FIREBASE_KEY_PATH=./firebase-service-account.json

# Adsterra PLATFORM/OWNER token (optional) — used only by admin endpoints and as a
# fallback. Every regular user saves THEIR OWN Adsterra publisher API key inside the
# app (SmartLinks → Adsterra Publisher API Token) and sees their own account.
ADSTERRA_API_TOKEN=your_adsterra_publisher_api_key_here

# Free starter impression balance granted to every NEW user (v39 default = 10).
# Small on purpose: it is a test allowance so a user can validate their OWN Adsterra
# account end-to-end, not a giveaway. Set to 0 to disable, or raise it if you want.
FREE_STARTER_IMPRESSIONS=10
# ── Google sign-in (Login / Sign up with Google) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Add your site URL (e.g. https://yourdomain.com) to "Authorized JavaScript origins".
# NOTE: Google does not accept a bare IP address as an origin — you need a domain.
GOOGLE_CLIENT_ID=

# ── Email (verification code on sign-up + password reset) ──
# Any SMTP works (Gmail app-password, Brevo, Zoho...). Leave empty to disable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AD MARKETING <no-reply@yourdomain.com>

# ── Firebase Auth (Google sign-in + password-reset email) ──
# Firebase Console → Project settings → General → "Your apps" → Web app → SDK setup and configuration.
# These are PUBLIC web keys (safe to ship). If left blank the server auto-derives them
# from the service-account project, so Google sign-in / e-mail verification / password
# reset all work out of the box. Values below match firebase-service-account.json.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# ── Sign-up protection / email verification ──
# Built-in image CAPTCHA on the Register form (works on any address, no Google keys). Set to "off" to disable.
AUTH_CAPTCHA=on
# Email verification mode is chosen automatically:
#   SMTP_* filled in  -> user gets a 6-digit CODE from your mailbox
#   only Firebase key -> Firebase emails the user a verification LINK (no SMTP needed)
# Set to "off" to skip verification completely.
AUTH_EMAIL_VERIFY=on

# ─────────────────────────────────────────────────────────────
# SUPERCHAT BD PAYMENTS  (Hosted Checkout)  —  replaces the old auto-payment
# ─────────────────────────────────────────────────────────────
# Provider dashboard:  https://superchatbd.com   (create keys + webhooks here)
# API base:            https://api.superchatbd.com
#
#  1. SUPERCHAT_ENVIRONMENT  → "test" while integrating, "live" in production.
#  2. SUPERCHAT_API_KEY      → your secret key (sk_test_… / sk_live_…).
#                              SECRET — never commit it, never expose to a browser.
#  3. SUPERCHAT_WEBHOOK_SECRET → signing secret returned when you register the
#                              webhook (Admin → Payments → Register Webhook, or the
#                              provider dashboard). Required to verify callbacks.
#  4. APP_URL                → public origin of THIS website, used to build the
#                              success/cancel return URLs. No trailing slash.
#                              Example: https://yourdomain.com
SUPERCHAT_ENVIRONMENT=live
SUPERCHAT_API_KEY="your_superchat_api_key_here"
SUPERCHAT_WEBHOOK_SECRET="your_superchat_webhook_secret_here"
SUPERCHAT_BASE_URL=https://api.superchatbd.com
APP_URL=https://pnadnetwork.dpdns.org
#  5. PAYMENT_REDIRECT_BASE_URL (optional) -> HTTPS base for the success/cancel
#                              return URLs. SuperChat LIVE mode requires HTTPS,
#                              so set this to your TLS domain when APP_URL is a
#                              bare IP. Leave blank to reuse APP_URL.
#                              Example: https://yourdomain.com
PAYMENT_REDIRECT_BASE_URL=https://pnadnetwork.dpdns.org

# Payment behaviour
PAYMENT_CURRENCY=BDT
PAYMENT_EXPIRATION_MINUTES=60
PAYMENT_MIN_AMOUNT=10
PAYMENT_MAX_AMOUNT=6000

# Advanced (optional — defaults shown; leave blank to use defaults)
SUPERCHAT_TIMEOUT_MS=15000
SUPERCHAT_WEBHOOK_TOLERANCE=300

# ── Traffic Engine tuning (optional — defaults are RAM-tier aware) ─────────
# The engine auto-sizes parallel visits from the box's RAM tier:
#   2 GB → up to 10 slots (~55-80 users)   4 GB → up to 22 (~250-320 users)
#   8 GB → up to 46 slots                  16 GB → up to 80
# Leave these BLANK to use the automatic tier defaults. Set only to override.
# BROWSER_KIND=shell            # 'shell' (light, 2GB) | 'full' (heavy pages)
# MAX_CONCURRENT_VISITS=        # hard ceiling on parallel visits
# RESERVED_MB=                  # RAM kept for OS + Node + Firebase
# CPU_SLOTS_PER_CORE=           # concurrent visits per vCPU (shell default 12)
# MAX_VISITS_PER_WORKER=120     # recycle a worker after N visits (leak guard)
# WORKER_TICK_MS=30000          # producer scan interval (ms)

